# -*- coding: utf-8 -*-
"""Validador local de Club Park. Ejecutar: python validar_despliegue.py"""
import os
import sys
import subprocess
import json
import py_compile

ROOT = os.path.dirname(os.path.abspath(__file__))
APP = os.path.join(ROOT, "app.py")
failures = []
print("=" * 68)
print("VALIDACIÓN LOCAL DE CLUB PARK")
print("=" * 68)

print("\n[1/5] Sintaxis y dependencias declaradas")
try:
    py_compile.compile(APP, doraise=True)
    print("PASS: app.py compila")
except Exception as e:
    print("FAIL:", e)
    sys.exit(1)

required = ["streamlit", "pandas", "openpyxl", "xlsxwriter", "PIL", "cryptography", "pytesseract"]
for name in required:
    try:
        __import__(name)
        print(f"PASS: {name}")
    except ImportError:
        failures.append(f"Missing dependency: {name}")
        print(f"FAIL: falta {name}")

print("\n[2/5] Sistema OCR")
try:
    import pytesseract
    pytesseract.get_tesseract_version()
    langs = set(pytesseract.get_languages(config=""))
    if "spa" not in langs:
        print("WARN: Tesseract encontrado, idioma spa no instalado; solo OCR available/default language")
    else:
        print("PASS: Tesseract con español instalado")
except Exception as e:
    print("WARN: OCR no disponible en este entorno:", e)
    print("      En Streamlit Cloud instalar packages.txt; la app conserva análisis heurístico sin OCR.")

print("\n[3/5] Pruebas funcionales de la app (Excel, cifrado, imagen, auditoría)")
env = os.environ.copy()
env["CLUBPARK_TEST_MODE"] = "1"
env["CLUBPARK_DATA_DIR"] = os.path.join(ROOT, ".clubpark_test_data")
os.makedirs(env["CLUBPARK_DATA_DIR"], exist_ok=True)
proc = subprocess.run([sys.executable, APP], cwd=ROOT, env=env, text=True, capture_output=True)
if proc.returncode != 0:
    failures.append("La suite interna de regresión falló")
    print("FAIL:", proc.stderr or proc.stdout)
else:
    try:
        result = json.loads(proc.stdout.strip().splitlines()[-1])
        for test in result:
            state = test.get("Resultado", "")
            print(f"{state} | {test.get('Área')}: {test.get('Prueba')}")
            if "PASS" not in state:
                failures.append(test.get("Prueba", "Prueba sin nombre"))
    except Exception as e:
        failures.append(f"Salida de suite no legible: {e}")
        print("FAIL: salida inesperada", proc.stdout[-1500:])

print("\n[4/5] Revisión de configuración Streamlit")
for key in ["PASS_SUPERVISOR", "PASS_AUDITOR"]:
    print(f"INFO: definir {key} en Secrets de Streamlit Cloud antes de iniciar sesión")
print("INFO: añadir app.py, requirements.txt y packages.txt al directorio raíz del repo")

print("\n[5/5] Resultado")
if failures:
    print("FAIL: revisión local incompleta; corregir:")
    for item in failures:
        print(" -", item)
    sys.exit(1)
print("PASS: pruebas locales superadas. El despliegue real aún debe verificarse en Streamlit Cloud.")
print("NOTA: esta prueba no verifica secretos remotos, cámara real Android, OCR sobre un reporte real ni persistencia remota.")
